<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".BlockBalanceApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${grayAppLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Firebase: monochrome notification icon + default channel. Channel id
             is per-project and comes from gray.properties → BuildConfig →
             the manifest placeholder below. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notif_flame" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="${grayFcmChannelId}" />

        <!-- ══ LAUNCHER: gray/white router (shows the splash, decides the mode) ══ -->
        <activity
            android:name=".net.LaunchGate"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.WindowGlue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- AppsFlyer OneLink. Host is a per-project placeholder; if the
                 project has no OneLink, gray.oneLinkHost stays "nolink.invalid"
                 and gray.oneLinkVerify=false, and this filter matches nothing. -->
            <intent-filter android:autoVerify="${grayOneLinkVerify}">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${grayOneLinkHost}" />
            </intent-filter>
        </activity>
        <activity
            android:name=".StageActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|locale|layoutDirection|fontScale"
            android:launchMode="singleTop"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.BlockBalance"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.OrbitShell"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.App.Stream" />
        <activity
            android:name=".view.SignalLostScreen"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App.WindowGlue" />
        <activity
            android:name=".view.OptInPrompt"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App.WindowGlue" />

        <service
            android:name=".attr.FcmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
